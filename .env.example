# Contrato de variáveis de ambiente (seção 5.14 da especificacao.md).
# Copie para `.env` e preencha — NUNCA versione chaves reais (RNF04).

# Corpus
BANCOS=BTG,ITAU,BRADESCO,SANTANDER,BB
N_TRIMESTRES=4

# Chunking
CHUNK_TAMANHO_TOKENS=600
CHUNK_SOBREPOSICAO_TOKENS=100

# Extração de PDF (spec 5.3). A ingestão nunca chama a API: ``mistral_ocr`` lê
# o cache versionado em corpus/ocr/ (RNF10) e roda sem os PDFs; ``pdfplumber``
# é o extrator por biblioteca, que exige corpus/raw/ e serve de alternativa
# atrás da mesma interface. EXTRACAO_PDF_MODO foi aposentada: se ainda estiver
# no seu .env, a configuração falha com mensagem de migração.
EXTRATOR=mistral_ocr              # mistral_ocr | pdfplumber

# Mistral Document AI/OCR — modelo pinado para reprodutibilidade. A etapa
# externa exige também --permitir-api-paga e obedece ao teto abaixo.
MISTRAL_API_KEY=
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr
MISTRAL_OCR_MODELO=mistral-ocr-4-0
MISTRAL_OCR_TIMEOUT_S=180
MISTRAL_OCR_MAX_RETRIES=0          # evita cobrança duplicada após timeout
MISTRAL_OCR_TABLE_FORMAT=html     # html | markdown
MISTRAL_OCR_INCLUDE_BLOCKS=true
MISTRAL_OCR_CONFIDENCE_GRANULARITY=page  # page | word
MISTRAL_OCR_LIMIAR_CONFIANCA_MEDIA=0.95  # limiar de diagnóstico (5.4), não bloqueia
MISTRAL_OCR_PRECO_USD_MIL_PAGINAS=4
MISTRAL_OCR_ORCAMENTO_TETO_USD=8

# Dados estruturados — painel contábil da CVM (seção 5.5)
DUCKDB_PATH=artefatos/cvm.duckdb
CVM_ANO_INICIAL=2025          # painel casado com a janela do corpus, não com o histórico do portal
SQL_LIMITE_LINHAS=50          # resultado é reinjetado no contexto do agente; 200 estourava o pior caso
SQL_TIMEOUT_S=10

# Recuperação
TOP_K=5
ESTRATEGIA_PADRAO=semantica       # closed_book | keyword | semantica | hibrida | fatos
CHROMA_PATH=artefatos/indice_vetorial

# Provedores (plugável — RNF06). Gemini é o perfil ativo; Ollama é fallback.
EMBEDDING_PROVIDER=ollama         # ollama | local | azure_openai | openai
LLM_PROVIDER=gemini               # gemini | ollama | azure_openai | openai | deepseek
TEMPERATURA=0                     # determinismo na avaliação (RNF08)

# Ollama local — sem chave e sem custo por chamada
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODELO_LLM=qwen2.5:14b
OLLAMA_MODELO_EMBEDDING=bge-m3
OLLAMA_EMBEDDING_DIMENSAO=1024
OLLAMA_TIMEOUT_S=180
OLLAMA_MAX_TOKENS=512
OLLAMA_EMBEDDING_BATCH_SIZE=4

# Gemini API — geração opcional; ative com LLM_PROVIDER=gemini.
# GOOGLE_API_KEY é aceito como alias de compatibilidade com o Google AI Studio.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GOOGLE_API_KEY=
# gemini-3.5-flash-lite venceu o comparativo contra 3.1-flash-lite e DeepSeek
# V4 Flash com o prompt a3 (2026-08-15): acerto 0,933 x 0,400 (3.1) x 0,600
# (DeepSeek), com menor latência — n pequeno (2-3 reps), confirmação agendada.
GEMINI_MODELO_LLM=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=120
GEMINI_MAX_TOKENS=512
GEMINI_REASONING_EFFORT=low
GEMINI_PRECO_ENTRADA_USD_MILHAO=0.30
GEMINI_PRECO_SAIDA_USD_MILHAO=2.50

# Azure — preencher somente no Gate G1 de pré-deploy (Fase 3)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_LLM=
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=

# Provedores pagos opcionais — Azure só no pré-deploy; Gemini está acima
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODELO=deepseek-chat
# DeepSeek cobra entrada em duas faixas (cache-hit e cache-miss) e, a partir
# de 2026-08-16 16:00 UTC, também por horário (peak 01h-04h/06h-10h UTC,
# off-peak no resto — peak custa o dobro). O default usa PEAK + cache-miss, o
# pior caso em qualquer horário, para o teto continuar conservador. Confira a
# tabela vigente do provedor antes de rodar — preço muda sem aviso no .env.
DEEPSEEK_PRECO_ENTRADA_USD_MILHAO=0.44
DEEPSEEK_PRECO_ENTRADA_CACHE_HIT_USD_MILHAO=0.014
DEEPSEEK_PRECO_SAIDA_USD_MILHAO=1.32
# deepseek-v4-flash é modelo de raciocínio: completion_tokens cobre o
# reasoning_content interno ANTES do content visível. 512 (o valor que serve
# ao Gemini) esgota pensando e devolve conteúdo vazio; no laço de agentes,
# mesmo 4000 não bastou em várias perguntas.
DEEPSEEK_MAX_TOKENS=20000
DEEPSEEK_REASONING_EFFORT=max     # high | max — a DeepSeek recomenda "max" para agente com ferramentas

# Agentes (seção 5.9) — estourou o teto, a resposta sai marcada como parcial
AGENTES_MAX_ITERACOES=6
AGENTES_MAX_CHAMADAS_FERRAMENTA=8

# Segurança (seção 5.11)
GUARDRAILS_ATIVOS=injection,topico_proibido,pii
GUARDRAILS_USAR_ONNX=true
GUARDRAILS_LIMIAR_INJECTION=0.85
# Pesos do Prompt Guard 2 são embutidos na imagem no build (modelo gated no Hugging Face).
# HF_TOKEN é segredo de BUILD, nunca de runtime — se ele for exigido em runtime, a RNF12
# (demo abre sem segredo) está quebrada e o build está errado. Runtime carrega com
# local_files_only=True: confirmado que não pede token depois de baixado.
GUARDRAILS_MODELO_INJECAO_REVISION=a8ded8e697ce7c355e395a0df51f94adb4a2fd27
PRESIDIO_IDIOMA=pt
PRESIDIO_MODELO_SPACY=pt_core_news_md
# Desligados por padrão: exigem requirements-guardrails.txt (Presidio soma
# ~40 MB do modelo spaCy; Prompt Guard 2 exige os pesos gated no cache local).
# Sem eles instalados, os detectores determinísticos continuam cobrindo os
# 20/20 ataques do conjunto medido — ligar é decisão de deploy, não lacuna.
PRESIDIO_HABILITADO=false
PROMPT_GUARD_HABILITADO=false
PROMPT_GUARD_MODELO=meta-llama/Llama-Prompt-Guard-2-86M

# Observabilidade (seção 5.12) — o Langfuse observa o caminho interativo;
# o registro do benchmark congelado é o JSONL versionado (RNF08), não ele.
# Sem as duas chaves, o rastreamento fica desligado e o app sobe igual.
# Host da região do projeto: https://cloud.langfuse.com (UE) ou
# https://us.cloud.langfuse.com (EUA). Precisa ser HTTPS.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Avaliação
CONJUNTO_PADRAO_PATH=conjunto_padrao/perguntas.csv
TOLERANCIA_NUMERICA_PCT=1
DEEPEVAL_MODELO_JUIZ=         # OBRIGATÓRIO para rodar a suíte: vazio faz o DeepEval usar um
                              # default próprio com chave própria, furando RNF06 (provedor
                              # plugável) e RNF03 (teto) sem erro visível. O código FALHA.
ORCAMENTO_TETO_USD=25             # teto a priori (RNF03) — execução pausa ao atingir

# Exposição pública (Fase 3)
LIMITE_PERGUNTAS_LIVRES_POR_SESSAO=5
LIMITE_CARACTERES_PERGUNTA=2000
HABILITAR_PERGUNTAS_LIVRES=false   # opt-in; mantém qualquer API ao vivo desligada
MODO_DEMONSTRACAO_CACHEADO=true

# RN07 condicional ao modo (AGENTS.md §3.6). FALSO = instância pública: pergunta
# prospectiva sobre emissor nomeado ("o banco X terá prejuízo?") recebe recusa
# fundamentada na Res. CVM 20/2021 mais histórico arquivado, regime de risco por
# porte e panorama agregado do painel. VERDADEIRO = modo local/autenticado:
# acrescenta o escore daquele emissor, etiquetado como fora de domínio.
#
# NUNCA ligue na instância pública. Ligar exige
# `artefatos/modelo/escores_por_companhia.json`, que fica FORA do Git e é
# gerado por `scripts/gerar_panorama_modelo.py --com-escores`; sem ele a carga
# falha fechada em vez de degradar em silêncio para o modo público.
PREVISAO_POR_EMISSOR_HABILITADA=false
