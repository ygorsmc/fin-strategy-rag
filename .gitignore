# O repositório publicado leva só o que é preciso para reproduzir o produto e
# a avaliação dele: código, testes, dependências, conjunto-padrão, manifestos
# com URL e SHA-256, o cache de OCR e os artefatos que o app lê. O resto se
# regenera por script ou é material local de trabalho.

# ----------------------------------------------------------------------------
# Python, ambientes e editores
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.venv/
venv/
env/
ENV/
.uv_cache/
.pytest_cache/
.coverage
htmlcov/
.deepeval/
.deepeval-cache.json
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.bak
*.backup
*.orig

# ----------------------------------------------------------------------------
# Segredos (RNF04)
# ----------------------------------------------------------------------------
.env*
!.env.example
.envrc
.envrc.*
.streamlit/secrets*.toml
**/.streamlit/secrets*.toml
*.pem
*.key
*.p12
*.pfx
*.keystore
*service-account*.json
credentials/
secrets/

# ----------------------------------------------------------------------------
# Documentos de trabalho e configuração de agentes de código
# ----------------------------------------------------------------------------
# .docs/ nunca é publicado (menciona a vaga de origem). DESAFIO_CBL.md, na
# raiz, é a cópia publicável do desafio.
.docs/
.claude/
AGENTS.md
CLAUDE.md
MEMORY.md
docs/etapa1/nao_entregue/
conferencia_*_v3/

# ----------------------------------------------------------------------------
# Pesos de modelo (embutidos no build ou regeneráveis)
# ----------------------------------------------------------------------------
modelos_lora/
modelos_guardrails/
*.onnx
*.safetensors
*.pt
*.ckpt
*.pkl
*.zip

# ----------------------------------------------------------------------------
# corpus/ — manifestos e cache de OCR; os PDFs vêm de scripts/baixar_corpus.py
# ----------------------------------------------------------------------------
corpus/*
!corpus/metadados.csv
!corpus/ancoras_sentinela.csv
# Cache de OCR versionado (RNF10): o OCR é pago e não é determinístico, e o
# hash dele faz parte da identidade do índice (RNF09).
!corpus/ocr/
!corpus/raw/
corpus/raw/*
!corpus/raw/.gitkeep
# Painel da CVM: manifesto pinado por hash e correções com procedência (RN09).
!corpus/cvm/
corpus/cvm/*
!corpus/cvm/manifesto_cvm.csv
!corpus/cvm/correcoes_contabeis.csv
# Demonstrações em IFRS: âncora do gate G4 (manifesto e o recorte de OCR).
!corpus/ifrs/
corpus/ifrs/*
!corpus/ifrs/manifesto_ifrs.csv
!corpus/ifrs/ocr/
!corpus/ifrs/raw/
corpus/ifrs/raw/*
!corpus/ifrs/raw/.gitkeep

# ----------------------------------------------------------------------------
# artefatos/ — só o que o app e os testes leem
# ----------------------------------------------------------------------------
# O painel DuckDB, o índice Chroma e os logs de execução se regeneram por
# scripts/baixar_cvm.py, construir_painel_cvm.py e executar_pipeline.py.
artefatos/*
!artefatos/indice_vetorial/
artefatos/indice_vetorial/*
!artefatos/indice_vetorial/.gitkeep
!artefatos/indice_vetorial/metadados_construcao.json
!artefatos/logs_execucoes/
artefatos/logs_execucoes/*
!artefatos/logs_execucoes/.gitkeep
!artefatos/ocr_mistral/
artefatos/ocr_mistral/*
!artefatos/ocr_mistral/.gitkeep
# Modelo: métricas e o panorama agregado que o chat lê. O binário fica fora.
!artefatos/modelo/
artefatos/modelo/*
!artefatos/modelo/*.json
artefatos/modelo/auditoria_alvo_c1.json
# RN07 em disco: o escore por companhia não pode existir no deploy público.
artefatos/modelo/escores_por_companhia.json
# Rodada congelada (o modo demonstração lê as respostas cacheadas) e DeepEval.
!artefatos/resultados_avaliacao/
# Respostas gravadas dos agentes (lidas por medir_guarda_rotulo_agentes.py).
!artefatos/resultados_agentes/
# Traces reais do Langfuse conferidos pela API (Etapa 2).
!artefatos/observabilidade/
# Conjunto adversarial das rotas do painel e a comparação entre elas.
!artefatos/roteamento_adversarial/
!artefatos/comparacao_rotas_painel.json
artefatos/**/*.lock
artefatos/**/.*.staging-*
artefatos/**/.*.backup-*
artefatos/**/.*.tmp-*

# ----------------------------------------------------------------------------
# resultados/ — relatórios dos números publicados no README e no relatório
# ----------------------------------------------------------------------------
resultados/*
!resultados/ajustes_etapa2_2026-10-20.md
!resultados/deepeval_2026-10-20.md
!resultados/auditoria_groundedness_2026-08-22.md
!resultados/concordancia_juiz_humano_2026-08-23.md
!resultados/comparacao_llm_2026-08.md
!resultados/comparacao_*_x_*.json
!resultados/teto_comparativas_2026-08-23.md
!resultados/guardrails.json
!resultados/gate.md
!resultados/gate_local.md
!resultados/gate_gemini.md
!resultados/gate_deepseek.md
!resultados/gate_g3.md
!resultados/gate_g4.md
!resultados/ancora_btg_4T2025.md
!resultados/modelo_preditivo_2026-08-23.md
!resultados/revisoes_modelo_2026-08-23.md
!resultados/robustez_modelo_2026-08-24.md
!resultados/debate_modelo_2026-08-25.md
!resultados/pre_registro_roteamento_adversarial_2026-09-15.md

